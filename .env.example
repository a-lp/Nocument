# Nocument environment variables. Copy this file to .env (not in git) and uncomment the variables to change:
#
#   cp .env.example .env
#
# Who reads .env:
# - Docker Compose (compose.yaml, compose.dev.yaml): the ${...} values of the compose files and, through env_file,
#   the variables of the app containers. Variables set under "environment" in the compose files win over .env
#   (e.g. MONGODB_URI, which always points to the mongo service).
# - Local runs (python -m src.app): the backend does not read .env by itself; load it in the shell first:
#     set -a; . ./.env; set +a; python -m src.app
#
# Every value below is the default used when the variable is not set.

# ---------------------------------------------------------------------------------------------------------------
# Docker Compose: ports
# ---------------------------------------------------------------------------------------------------------------

# Port of the web app in production (compose.yaml).
# NOCUMENT_PORT=8080

# Port of the web app in development (compose.dev.yaml, Vite dev server).
# NOCUMENT_DEV_PORT=5173

# Host names, separated by commas, the development web app answers to besides localhost (e.g. the name of the
# server in the local network). Vite refuses requests for other names.
# NOCUMENT_DEV_ALLOWED_HOSTS=

# Port of MongoDB published on 127.0.0.1 in development, for a backend on the host or MongoDB Compass.
# MONGODB_DEV_PORT=27017

# Number of gunicorn workers (production image only).
# GUNICORN_WORKERS=2

# ---------------------------------------------------------------------------------------------------------------
# Content blocks database
# ---------------------------------------------------------------------------------------------------------------

# MongoDB URI. When set, the content blocks are saved in MongoDB; when empty, in the SQLite file NOCUMENT_DATABASE.
# The compose files always set it to mongodb://mongo:27017.
# MONGODB_URI=mongodb://localhost:27017

# MongoDB database of the content blocks (only with MONGODB_URI).
# MONGODB_DATABASE=nocument

# SQLite file of the content blocks, used when MONGODB_URI is not set (created at the first save).
# NOCUMENT_DATABASE=instance/nocument.sqlite3

# "memory" keeps the content blocks in memory instead of SQLite: they are lost when the backend restarts (for tests).
# NOCUMENT_STORAGE=

# ---------------------------------------------------------------------------------------------------------------
# Server settings
# ---------------------------------------------------------------------------------------------------------------

# JSON file of the settings chosen in the Settings page (e.g. the PDF renderer).
# NOCUMENT_SETTINGS=instance/settings.json

# Port and address of the development backend (python -m src.app, run-dev.bat, compose.dev.yaml); the Vite /api proxy
# uses the same port. Not used by the production image (gunicorn behind nginx).
# NOCUMENT_BACKEND_PORT=5000
# NOCUMENT_BACKEND_HOST=127.0.0.1

# ---------------------------------------------------------------------------------------------------------------
# Logging (backend, services and plugins)
# ---------------------------------------------------------------------------------------------------------------

# Minimum level of the log: DEBUG, INFO, WARNING or ERROR.
# NOCUMENT_LOG_LEVEL=INFO

# Levels of single loggers, comma separated, e.g. a plugin in detail and fewer request lines:
# NOCUMENT_LOG_LEVELS=nocument.plugins.azure-devops-query=DEBUG,werkzeug=WARNING

# Log file, rotated by size; empty to log only to the console.
# NOCUMENT_LOG_FILE=instance/logs/nocument.log

# Size of the log file before rotation (bytes) and number of old files kept (nocument.log.1, .2, ...).
# NOCUMENT_LOG_MAX_BYTES=5242880
# NOCUMENT_LOG_BACKUPS=5

# ---------------------------------------------------------------------------------------------------------------
# PDF renderers (LibreOffice)
# ---------------------------------------------------------------------------------------------------------------

# LibreOffice executable. Default: automatic search in the PATH and in the standard Windows folders
# (the Docker images use /usr/bin/soffice).
# SOFFICE_PATH=/usr/bin/soffice

# Timeout, in seconds, of a LibreOffice conversion.
# SOFFICE_TIMEOUT=120

# Python with LibreOffice's uno module, used to update the tables of contents. Default: automatic search
# (LibreOffice's own Python on Windows, the system python3 with python3-uno on Linux).
# UNO_PYTHON=/usr/bin/python3

# ---------------------------------------------------------------------------------------------------------------
# Plugins
# ---------------------------------------------------------------------------------------------------------------

# Folder of the plugin scripts.
# NOCUMENT_PLUGINS_DIR=plugins

# "false" forbids installing and removing plugins from the web app: plugins run Python code on the server and the
# web app has no login, so disable it on a server reachable by others and copy the plugins into the folder by hand.
# NOCUMENT_PLUGIN_UPLOAD=true

# ---------------------------------------------------------------------------------------------------------------
# Plugin: Azure DevOps query (azure_devops_plugin.py)
# ---------------------------------------------------------------------------------------------------------------

# URL of the Azure DevOps / TFS collection: required to use the plugin.
# AZURE_DEVOPS_URL=http://your-server:8080/tfs/DefaultCollection

# Personal access token used when the Token field of the plugin is left empty. It is a secret: set it only in .env,
# never in this template.
# AZURE_DEVOPS_TOKEN=
